{
  "name": "personal-reports",
  "version": "1.0.6",
  "private": true,
  "description": "TypeScript scripts for GitHub Actions",
  "license": "GPL-3.0-only",
  "author": "7Koston",
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "clean": "node ./scripts/clean.ts dist",
    "clean:deps": "node ./scripts/clean.ts dist node_modules pnpm-lock.yaml",
    "format": "prettier src/** --write",
    "lint": "eslint src/** && tsc --noEmit",
    "lint:fix": "eslint src/** --fix && tsc --noEmit",
    "local": "node --env-file=.env src/index.ts",
    "local:google:token": "node --env-file=.env scripts/google-refresh-token.ts"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "open": "^11.0.0",
    "prettier": "^3.9.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.18.0"
  }
}
